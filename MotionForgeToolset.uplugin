{
  "FileVersion": 3,
  "Version": 2,
  "VersionName": "0.2.0",
  "FriendlyName": "MotionForge Toolset",
  "Description": "Exposes MotionForge's pipeline as native Model Context Protocol tools, so an agent can author motion definitions, generate, review, download and import without a human driving the editor. Adapter only - it holds no pipeline logic and can be removed without affecting MotionForge.",
  "Category": "Automation Forge",
  "CreatedBy": "Bojan Andrejek",
  "CreatedByURL": "https://automation-forge-hq.web.app",
  "DocsURL": "https://github.com/AutomationForgeHQ/MotionForgeToolset",
  "MarketplaceURL": "",
  "SupportURL": "https://github.com/AutomationForgeHQ/MotionForgeToolset/issues",
  "EditorOnly": true,
  "EnabledByDefault": false,
  "CanContainContent": false,
  "IsBetaVersion": false,
  "IsExperimentalVersion": true,
  "Installed": false,
  "Modules": [
    {
      "Name": "MotionForgeToolset",
      "Type": "Editor",
      "LoadingPhase": "PostEngineInit",
      "TargetAllowList": [
        "Editor"
      ]
    }
  ],
  "Plugins": [
    {
      "Name": "MotionForge",
      "Enabled": true
    },
    {
      "Name": "ToolsetRegistry",
      "Enabled": true
    },
    {
      "Name": "ModelContextProtocol",
      "Enabled": true
    }
  ]
}
